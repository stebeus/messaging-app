{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": "//",
	"linter": {
		"rules": {
			"correctness": {
				"noGlobalDirnameFilename": "on",
				"noProcessGlobal": "on"
			},
			"style": {
				"useNamingConvention": {
					"level": "on",
					"options": {
						"conventions": [
							{
								"formats": ["camelCase", "CONSTANT_CASE"],
								"selector": {
									"kind": "objectLiteralProperty"
								}
							},
							{
								"formats": ["camelCase", "PascalCase"],
								"selector": {
									"kind": "typeProperty"
								}
							}
						]
					}
				}
			}
		}
	}
}
