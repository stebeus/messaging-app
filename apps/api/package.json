		"express": "^5.2.1",
		"express-zod-safe": "^3.2.1",
		"pino-http": "^11.0.0",
		"postgres": "^3.4.9",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"@types/supertest": "^7.2.1",
