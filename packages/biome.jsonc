{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"root": false,
	"extends": "//",
	"linter": {
		"rules": {
			"correctness": {
				"useImportExtensions": {
					"level": "on",
					"options": {
						"extensionMappings": {
							"ts": "js",
							"tsx": "js"
						}
					}
				}
			}
		}
	}
}
